<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lecturesystem.modules.agent.mapper.AiPolicyCandidateAnswerMapper">
    <resultMap id="AiPolicyCandidateAnswerMap" type="com.example.lecturesystem.modules.agent.entity.AiPolicyCandidateAnswerEntity">
        <id property="id" column="id"/>
        <result property="baseId" column="base_id"/>
        <result property="regionScope" column="region_scope"/>
        <result property="policyKey" column="policy_key"/>
        <result property="intentId" column="intent_id"/>
        <result property="rawQuestion" column="raw_question"/>
        <result property="finalAnswer" column="final_answer"/>
        <result property="sourceType" column="source_type"/>
        <result property="reviewStatus" column="review_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.lecturesystem.modules.agent.entity.AiPolicyCandidateAnswerEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_policy_candidate_answer (
            base_id, region_scope, policy_key, intent_id, raw_question, final_answer,
            source_type, review_status, created_at, updated_at
        ) VALUES (
            #{baseId}, #{regionScope}, #{policyKey}, #{intentId}, #{rawQuestion}, #{finalAnswer},
            #{sourceType}, #{reviewStatus}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <delete id="deleteByBaseId">
        DELETE FROM ai_policy_candidate_answer WHERE base_id = #{baseId}
    </delete>

    <select id="queryByReviewStatus" resultMap="AiPolicyCandidateAnswerMap">
        SELECT *
        FROM ai_policy_candidate_answer
        WHERE base_id = #{baseId}
          AND review_status = #{reviewStatus}
        ORDER BY updated_at DESC, id DESC
    </select>

    <select id="findById" resultMap="AiPolicyCandidateAnswerMap">
        SELECT * FROM ai_policy_candidate_answer WHERE id = #{id}
    </select>

    <update id="updateReviewStatus">
        UPDATE ai_policy_candidate_answer
        SET review_status = #{reviewStatus},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <select id="countByReviewStatus" resultType="int">
        SELECT COUNT(1)
        FROM ai_policy_candidate_answer
        WHERE base_id = #{baseId}
          AND review_status = #{reviewStatus}
    </select>
</mapper>
