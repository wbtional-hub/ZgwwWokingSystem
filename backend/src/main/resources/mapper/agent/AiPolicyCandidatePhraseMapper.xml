<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lecturesystem.modules.agent.mapper.AiPolicyCandidatePhraseMapper">
    <resultMap id="AiPolicyCandidatePhraseMap" type="com.example.lecturesystem.modules.agent.entity.AiPolicyCandidatePhraseEntity">
        <id property="id" column="id"/>
        <result property="baseId" column="base_id"/>
        <result property="regionScope" column="region_scope"/>
        <result property="policyKey" column="policy_key"/>
        <result property="rawQuestion" column="raw_question"/>
        <result property="normalizedQuestion" column="normalized_question"/>
        <result property="suggestedIntentId" column="suggested_intent_id"/>
        <result property="sourceType" column="source_type"/>
        <result property="reviewStatus" column="review_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.lecturesystem.modules.agent.entity.AiPolicyCandidatePhraseEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_policy_candidate_phrase (
            base_id, region_scope, policy_key, raw_question, normalized_question, suggested_intent_id,
            source_type, review_status, created_at, updated_at
        ) VALUES (
            #{baseId}, #{regionScope}, #{policyKey}, #{rawQuestion}, #{normalizedQuestion}, #{suggestedIntentId},
            #{sourceType}, #{reviewStatus}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <delete id="deleteByBaseId">
        DELETE FROM ai_policy_candidate_phrase WHERE base_id = #{baseId}
    </delete>

    <select id="queryByReviewStatus" resultMap="AiPolicyCandidatePhraseMap">
        SELECT *
        FROM ai_policy_candidate_phrase
        WHERE base_id = #{baseId}
          AND review_status = #{reviewStatus}
        ORDER BY updated_at DESC, id DESC
    </select>

    <select id="findById" resultMap="AiPolicyCandidatePhraseMap">
        SELECT * FROM ai_policy_candidate_phrase WHERE id = #{id}
    </select>

    <update id="updateReviewStatus">
        UPDATE ai_policy_candidate_phrase
        SET review_status = #{reviewStatus},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <select id="countByReviewStatus" resultType="int">
        SELECT COUNT(1)
        FROM ai_policy_candidate_phrase
        WHERE base_id = #{baseId}
          AND review_status = #{reviewStatus}
    </select>
</mapper>
