<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lecturesystem.modules.agent.mapper.AiPolicyIntentAnswerMapper">
    <resultMap id="AiPolicyIntentAnswerMap" type="com.example.lecturesystem.modules.agent.entity.AiPolicyIntentAnswerEntity">
        <id property="id" column="id"/>
        <result property="baseId" column="base_id"/>
        <result property="intentId" column="intent_id"/>
        <result property="answerMode" column="answer_mode"/>
        <result property="answerTitle" column="answer_title"/>
        <result property="answerTemplate" column="answer_template"/>
        <result property="evidenceRule" column="evidence_rule"/>
        <result property="followupSuggestion" column="followup_suggestion"/>
        <result property="priority" column="priority"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.lecturesystem.modules.agent.entity.AiPolicyIntentAnswerEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_policy_intent_answer (
            base_id, intent_id, answer_mode, answer_title, answer_template, evidence_rule,
            followup_suggestion, priority, enabled, created_at, updated_at
        ) VALUES (
            #{baseId}, #{intentId}, #{answerMode}, #{answerTitle}, #{answerTemplate}, #{evidenceRule},
            #{followupSuggestion}, #{priority}, #{enabled}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <delete id="deleteByBaseId">
        DELETE FROM ai_policy_intent_answer WHERE base_id = #{baseId}
    </delete>

    <select id="countByBaseId" resultType="int">
        SELECT COUNT(1)
        FROM ai_policy_intent_answer
        WHERE base_id = #{baseId}
    </select>

    <select id="queryEnabledByBaseId" resultMap="AiPolicyIntentAnswerMap">
        SELECT *
        FROM ai_policy_intent_answer
        WHERE base_id = #{baseId}
          AND enabled = TRUE
        ORDER BY priority DESC, id ASC
    </select>

    <select id="queryByIntentId" resultMap="AiPolicyIntentAnswerMap">
        SELECT *
        FROM ai_policy_intent_answer
        WHERE intent_id = #{intentId}
          AND enabled = TRUE
        ORDER BY priority DESC, id ASC
    </select>
</mapper>
