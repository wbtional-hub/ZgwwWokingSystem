<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lecturesystem.modules.agent.mapper.AiPolicyIntentMapper">
    <resultMap id="AiPolicyIntentMap" type="com.example.lecturesystem.modules.agent.entity.AiPolicyIntentEntity">
        <id property="id" column="id"/>
        <result property="baseId" column="base_id"/>
        <result property="regionScope" column="region_scope"/>
        <result property="policyKey" column="policy_key"/>
        <result property="intentCode" column="intent_code"/>
        <result property="intentName" column="intent_name"/>
        <result property="standardQuestion" column="standard_question"/>
        <result property="questionType" column="question_type"/>
        <result property="topicType" column="topic_type"/>
        <result property="answerLevelDefault" column="answer_level_default"/>
        <result property="priority" column="priority"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.lecturesystem.modules.agent.entity.AiPolicyIntentEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_policy_intent (
            base_id, region_scope, policy_key, intent_code, intent_name, standard_question,
            question_type, topic_type, answer_level_default, priority, enabled, created_at, updated_at
        ) VALUES (
            #{baseId}, #{regionScope}, #{policyKey}, #{intentCode}, #{intentName}, #{standardQuestion},
            #{questionType}, #{topicType}, #{answerLevelDefault}, #{priority}, #{enabled}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <delete id="deleteByBaseId">
        DELETE FROM ai_policy_intent WHERE base_id = #{baseId}
    </delete>

    <select id="countByBaseId" resultType="int">
        SELECT COUNT(1)
        FROM ai_policy_intent
        WHERE base_id = #{baseId}
    </select>

    <select id="findById" resultMap="AiPolicyIntentMap">
        SELECT * FROM ai_policy_intent WHERE id = #{id}
    </select>

    <select id="findByCode" resultMap="AiPolicyIntentMap">
        SELECT *
        FROM ai_policy_intent
        WHERE base_id = #{baseId}
          AND intent_code = #{intentCode}
        LIMIT 1
    </select>

    <select id="queryEnabledByBaseId" resultMap="AiPolicyIntentMap">
        SELECT *
        FROM ai_policy_intent
        WHERE base_id = #{baseId}
          AND enabled = TRUE
        ORDER BY priority DESC, id ASC
    </select>
</mapper>
